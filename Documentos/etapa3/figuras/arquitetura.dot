digraph HIDRA {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.40", dpi=180];
 node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#475569", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#475569"];
 subgraph cluster_esp {
 label="ESP32 — firmware esp32-integrated"; fontname="DejaVu Sans"; fontsize=14; color="#98b7bf";
 hw [label="Hardware da etapa 1\nLeituras físicas + debounce + filtro"];
 orq [label="Orquestrador da etapa 2\nE0–E5, instruções, alertas e sessão"];
 act [label="Áudio e LED\nControle local"];
 adapter [label="Adapter da etapa 3\nHidraEvent → HidraIoT\nboot_id compartilhado + ordem NVS"];
 queue [label="Fila RAM → diário LittleFS\nTarefa de comunicação assíncrona"];
 hw -> orq; orq -> act; orq -> adapter [label="eventos + snapshot"]; adapter -> queue;
 }
 auth [label="Firebase Authentication\nConta por publicador e conta do cuidador"];
 db [label="Realtime Database\nEventos imutáveis + resumos + presença",fillcolor="#dcefe9"];
 app [label="Android 0.2.0\nDispositivos, acompanhamento, histórico\ne linha do tempo do cuidador"];
 queue -> db [label="HTTPS / REST"]; auth -> db [label="UID + vínculos"]; db -> app [label="SDK Android / listeners"];
}
